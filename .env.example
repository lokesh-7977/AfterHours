# ---------------------------------------------------------------- database
# Replica set / Atlas recommended (enables transactions).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/afterhours
# auto | required | disabled
MONGODB_TRANSACTIONS=auto

# ---------------------------------------------------------------- auth (Better Auth)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Also derives the keys that encrypt QR pass tokens and hash attendance codes;
# rotating it invalidates existing passes/codes (reissue passes after rotation).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
# Optional extra origins allowed to call mutating APIs, comma separated
TRUSTED_ORIGINS=
REQUIRE_EMAIL_VERIFICATION=true

# ---------------------------------------------------------------- Cloudflare R2 (private bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Intentionally unused: enabling R2 public access exposes the whole bucket,
# including private galleries. All media is served through authorized routes.
R2_PUBLIC_BASE_URL=

MEDIA_MAX_IMAGE_BYTES=15728640
MEDIA_MAX_VIDEO_BYTES=524288000
MEDIA_MAX_VIDEO_DURATION_SECONDS=600
MEDIA_DEFAULT_MAX_UPLOADS_PER_USER=50

# ---------------------------------------------------------------- first super admin (pnpm seed:admin)
# Remove the password after seeding.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=

# ---------------------------------------------------------------- email
# console (dev: prints to server log) | resend
EMAIL_PROVIDER=console
EMAIL_FROM=AfterHours <no-reply@example.com>
EMAIL_PROVIDER_API_KEY=

# ---------------------------------------------------------------- public site
# Contact address shown in the footer and FAQ. Leave blank to hide contact details.
CONTACT_EMAIL=

# ---------------------------------------------------------------- scheduled maintenance
# POST /api/v1/admin/maintenance with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
